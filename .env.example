# ── local 프로필에서 반드시 필요 ──────────────

# JWT 서명 키(HS256). UTF-8 기준 최소 32바이트여야 기동 시점 검증을 통과한다.
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-32-byte-min-secret

# 토큰 발급자 식별자. 임의 문자열이지만 환경별로 구분해서 쓴다.
JWT_ISSUER=aics-local

# 첨부파일 AES 키. UTF-8 기준 16 / 24 / 32바이트 중 하나여야 한다.
FILE_SECRET_KEY=change-me-16byte


# ── local에서는 기본값이 있어 생략 가능 ──────────────────────────────────

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=aics
# DB_USERNAME=root
# DB_PASSWORD=root
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# FILE_UPLOAD_PATH=./cloud
# MAX_FILE_SIZE=10MB
# MAX_REQUEST_SIZE=10MB


# ── dev / prod에서 추가로 필요 ─────────────────────────────────────────

# DB_USERNAME=
# DB_PASSWORD=
# REDIS_PASSWORD=
