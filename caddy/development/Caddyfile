# 클라이언트가 위조해서 보낼 수 있는 프록시 헤더를 업스트림에 전달하기 전에 제거한다.
# Caddy가 자체 생성하는 X-Forwarded-For/-Proto/-Host는 손대지 않고 그대로 신뢰한다 —
# Spring의 server.forward-headers-strategy: framework가 Forwarded 헤더를
# X-Forwarded-*보다 우선 신뢰하는데, Forwarded는 Caddy가 자동으로 안 걸러줘서
# 클라이언트가 직접 `Forwarded: proto=http;host=attacker.example` 같은 값을
# 보내면 그대로 통과해 신뢰 경계가 깨지는 문제(태양 리뷰, PR #71) 대응.
(strip_forwarded_headers) {
	header_up -Forwarded
	header_up -X-Forwarded-Prefix
	header_up -X-Forwarded-Port
	header_up -X-Forwarded-Ssl
}

team-project-api.kgudevelopers.monster {
	# 쿠키 기반 인증이 서브도메인을 못 넘어가는 문제 때문에 단일 도메인 + 경로 기반으로 통일.
	# aics-api/aics-admin/aics-auth가 전부 이 호스트 하나로 노출되므로,
	# 로그인 시 발급되는 accessToken/refreshToken 쿠키가 Domain 속성 없이도
	# 이후 모든 API 요청에 그대로 붙는다.
	handle /pgadmin* {
		reverse_proxy pgadmin:80 {
			import strip_forwarded_headers
		}
	}

	handle /api/v1/admin/* {
		reverse_proxy aics-admin:8081 {
			import strip_forwarded_headers
		}
	}

	handle /api/v1/auth/* {
		reverse_proxy aics-auth:8082 {
			import strip_forwarded_headers
		}
	}

	# aics-admin/aics-auth Swagger 문서 노출용 (springdoc 경로를 각각 커스텀 지정해 catch-all과 충돌 방지)
	handle /admin-docs* {
		reverse_proxy aics-admin:8081 {
			import strip_forwarded_headers
		}
	}

	handle /admin-api-docs* {
		reverse_proxy aics-admin:8081 {
			import strip_forwarded_headers
		}
	}

	handle /auth-docs* {
		reverse_proxy aics-auth:8082 {
			import strip_forwarded_headers
		}
	}

	handle /auth-api-docs* {
		reverse_proxy aics-auth:8082 {
			import strip_forwarded_headers
		}
	}

	handle {
		reverse_proxy aics-api:8080 {
			import strip_forwarded_headers
		}
	}
}
